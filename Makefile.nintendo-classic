sdk_root = /home/kali/Projects/N00b-Power.SDK
sdk_sysroot = ${sdk_root}/sysroot
linaro_cc = ${sdk_root}/gcc-linaro/bin

prefix = ${sdk_sysroot}/usr
exec_prefix = ${prefix}
bindir = ${exec_prefix}/bin

CC = ${linaro_cc}/arm-linux-gnueabihf-gcc
LD = ${linaro_cc}/arm-linux-gnueabihf-gcc
AS = ${linaro_cc}/arm-linux-gnueabihf-as
INSTALL = /usr/bin/install -c

CFLAGS = --sysroot=${sdk_sysroot} -marm -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -I${sdk_sysroot}/usr/include -I${sdk_sysroot}/usr/include/SDL2 -D_REENTRANT -DMALI
CFLAGS += -Wno-unused-function -Wno-deprecated-declarations -Wno-overlength-strings -Wall 
CFLAGS += -finline-limit=42 -fno-unroll-loops -fno-ipa-cp -ffast-math
CFLAGS += -fno-common -fno-stack-protector -fno-guess-branch-probability -fno-caller-saves -fno-tree-loop-if-convert -fno-regmove
CPPFLAGS = --sysroot=${sdk_sysroot} -DHAVE_SYS_SOUNDCARD_H
LDFLAGS = $(CFLAGS) --sysroot=${sdk_sysroot} -L${sdk_sysroot}/usr/lib -lSDL2
ASFLAGS = $(CFLAGS)

TARGETS =  sdl2gnuboy

ASM_OBJS = 

SYS_DEFS = -DHAVE_CONFIG_H -DIS_LITTLE_ENDIAN  
SYS_OBJS = sys/nix/nix.o $(ASM_OBJS)
SYS_INCS =  -I./sys/nix

SDL2_OBJS = sys/sdl2/sdl2.o sys/sdl2/sdl-audio.o sys/sdl2/keymap.o sys/sdl2/sdl-joystick.o
SDL2_LIBS = -lSDL2

all: $(TARGETS)

include Rules

fbgnuboy: $(OBJS) $(SYS_OBJS) $(FB_OBJS)
	$(LD) $(OBJS) $(SYS_OBJS) $(FB_OBJS) -o $@ $(FB_LIBS) $(LDFLAGS)

sgnuboy: $(OBJS) $(SYS_OBJS) $(SVGA_OBJS)
	$(LD) $(OBJS) $(SYS_OBJS) $(SVGA_OBJS) -o $@ $(SVGA_LIBS) $(LDFLAGS)

sdlgnuboy: $(OBJS) $(SYS_OBJS) $(SDL_OBJS)
	$(LD) $(OBJS) $(SYS_OBJS) $(SDL_OBJS) -o $@ $(SDL_LIBS) $(LDFLAGS)

sdl2gnuboy: $(OBJS) $(SYS_OBJS) $(SDL2_OBJS)
	$(LD) $(OBJS) $(SYS_OBJS) $(SDL2_OBJS) -o $@ $(SDL2_LIBS) $(LDFLAGS)

sys/sdl/sdl.o: sys/sdl/sdl.c
	$(MYCC) $(SDL_CFLAGS) -c $< -o $@

sys/sdl/keymap.o: sys/sdl/keymap.c
	$(MYCC) $(SDL_CFLAGS) -c $< -o $@

xgnuboy: $(OBJS) $(SYS_OBJS) $(X11_OBJS)
	$(LD) $(OBJS) $(SYS_OBJS) $(X11_OBJS) -o $@ $(X11_LIBS) $(LDFLAGS)

joytest: joytest.o sys/linux/joy.o
	$(LD) $^ -o $@ $(LDFLAGS)

install: all
	$(INSTALL) -d $(bindir)
	$(INSTALL) -m 755 $(TARGETS) $(bindir)

clean:
	rm -f *gnuboy gmon.out *.o sys/*.o sys/*/*.o asm/*/*.o $(OBJS)

distclean: clean
	rm -f config.* sys/nix/config.h Makefile




